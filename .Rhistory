par(mfrow=c(2,2))
plot(stepmix)
stepmix <- lm(
log(price) ~
log(livingArea) * (levels + homeType + isNewConstruction) +
f.bath * (parking + homeType) +
f.bed * homeType +
f.antig * (parking + levels + homeType) +
event + spa + pool,
data = df
)
summary(stepmix)
par(mfrow=c(2,2))
plot(stepmix)
mix1 <- lm(log(price)~(log(livingArea))*(f.antig+ event + parking + levels + pool + hasPetsAllowed + homeType + f.bed + f.bath + isNewConstruction), data = df)
summary(mix1)
par(mfrow=c(2,2))
plot(mix1)
df <- df_copy_old
# interaccions
mix <- lm(log(price)~(log(livingArea)+log(bathrooms)+poly(bedrooms,2) +poly(antiguetat,2))* (event + parking + levels + spa + pool + hasPetsAllowed + homeType + isNewConstruction), data = df)
summary(mix)
par(mfrow=c(2,2))
plot(mix)
vif(mix, type = 'predictor')
stepmix <- step(mix, k=log(nrow(df)))
summary(df)
